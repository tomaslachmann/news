// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x", "linux-musl-arm64-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AnalysisStatus {
  DRAFT
  PENDING
  COMPLETE
  FAILED
}

enum CoverageStatus {
  PENDING
  OK
  EXTRACTION_FAILED
}

enum UserRole {
  ADMIN
  READONLY
}

enum StoryRelationType {
  RELATED
  FOLLOW_UP
}

enum StoryRelationConfidenceTier {
  HIGH
  LOW
}

/// Synthesis's own story-level read of how much the sources overlap in what they report --
/// categorical for the same reason StoryRelationConfidenceTier is (ADR 0022): a raw float
/// invites being read as credibility. See ADR 0030 (ticket 38). Matches synthesisPass.ts's
/// AgreementCategorySchema and shared's AgreementCategory exactly -- kept in sync by hand, same
/// convention as every other closed enum this schema mirrors from a Zod schema (see
/// StoryRelationType/EntityType).
enum SynthesisAgreementCategory {
  CONFIRMED
  PARTIAL
  DISPUTED
}

enum StoryRelationStatus {
  PUBLISHED
  PENDING_REVIEW
  REJECTED
}

enum PendingAdditionStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum ThreadStatus {
  ACTIVE
  DORMANT
  CLOSED
}

/// REACTION is declared (ADR 0029's own schema) but never produced by ticket 17's `inferRole` —
/// see that ticket's Answer. Kept for a future role-inference refinement that wants it without a
/// schema change.
enum ThreadRole {
  ORIGIN
  DEVELOPMENT
  REACTION
  RESOLUTION
}

/// Matches entityTypes.ts's EntityTypeSchema exactly — kept in sync by hand, same convention as
/// every other closed enum this schema mirrors from a Zod schema (see StoryRelationType).
enum EntityType {
  PERSON
  ORGANIZATION
  PLACE
  COUNTRY
}

/// Matches entityTypes.ts's EntityRelationTypeSchema exactly.
enum EntityRelationType {
  REPRESENTS
  HOLDS_POSITION_IN
  WORKS_FOR
  MEMBER_OF
  LOCATED_IN
  BASED_IN
  PART_OF
  INVOLVES
  MEETS
  ATTACKS
  ACCUSES
  ANNOUNCES
}

/// Ticket 41 / ADR 0034 — v1 declares only WIKIMEDIA; a second provider (Openverse, Unsplash) is
/// additive later, not foreclosed, and is what would eventually motivate EntityImage.isPrimary.
enum EntityImageProvider {
  WIKIMEDIA
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         UserRole @default(READONLY)
  createdAt    DateTime @default(now())
}

/// The real-world event a cluster of Coverage is believed to be about — independent of and
/// created alongside its Analysis, so same-event matching has a stable identity to compare
/// against rather than being folded into Analysis's own DRAFT/PENDING/COMPLETE/FAILED lifecycle.
/// See ADR 0017.
model Story {
  id                   String                @id @default(cuid())
  createdAt            DateTime              @default(now())
  /// When the real-world event happened/was first reported — distinct from `createdAt` (row-
  /// insert/ingest time), which drifts from the former whenever a Draft sits in the Ingestion
  /// review queue before approval (ADR 0029, ticket 16, fixes the rest of P1-11, docs/audit.md).
  /// Sourced per creation path: Ingestion (`createDraftAnalysis`) uses
  /// `CandidateArticle.publishedAt` (RSS `pubDate`, or RSS's own fetch-time fallback when a feed
  /// omits one — Ingestion's own candidate pipeline is RSS-only; GDELT is Discovery's, a
  /// Coverage-only path that never creates a Story). Human-seeded submission (`createAnalysis`)
  /// leaves this `null` — `scrapeArticle` extracts no structured publish date today (see ticket
  /// 16's Answer, amending ADR 0029's "seed article's own published date where available" to an
  /// explicit "not attempted, stays null" for this one path), so every consumer (the
  /// `confirmStoryRelation` payload, relation-candidate time-decay scoring) falls back to
  /// `createdAt` at the point of use rather than a fabricated value being written here. Nullable,
  /// no default, no backfill for Stories created before this field existed — same convention as
  /// `embeddingModel`/`embeddingInputHash` above (ADR 0025), per ADR 0029's own consequences.
  eventTime            DateTime?
  /// The seed/triggering article's title, fixed at creation — what every same-event
  /// verification call compares a candidate article's title against.
  anchorHeadline       String
  /// Embedding of anchorHeadline (+ excerpt where available), used by the same-event
  /// classification step Ingestion and human-seeded submission now share (ADR 0018, ADR 0019).
  /// Every new Story gets one regardless of origin; empty only for Stories created before ADR
  /// 0019 shipped, or when embedding generation failed at creation — an empty vector never
  /// scores above the match threshold, so such a Story is simply never matched, not a broken
  /// state.
  embedding            Float[]               @default([])
  /// Which EMBEDDING_MODEL produced `embedding`, and the content hash of the canonical input
  /// that fed it (buildEmbeddingInput, storyMatching.ts) — audit trail for P1-8
  /// (docs/audit.md, ADR 0025): before this, a mid-flight EMBEDDING_MODEL change would silently
  /// mix incomparable vectors into the same matching pool with no way to detect it after the
  /// fact. Nullable: every Story created before this ticket has neither. Not used to gate
  /// matching itself — EmbeddingCache (below) is the actual idempotence mechanism.
  embeddingModel       String?
  embeddingInputHash   String?
  analysis             Analysis?
  relationsFrom        StoryRelation[]       @relation("StoryRelationFrom")
  relationsTo          StoryRelation[]       @relation("StoryRelationTo")
  /// A Story belongs to at most one Thread (ticket 17) — null until a FOLLOW_UP edge involving
  /// it is ever confirmed.
  threadMember         ThreadMember?
  /// Lightweight, non-authoritative entity signal extracted once (ticket 34), used only as
  /// candidate-scoring evidence for Story-to-Story relation linking (ticket 35) — never a
  /// knowledge graph, never surfaced to a reader/Admin as ground truth. Normalized into
  /// Entity/StoryEntity (ADR 0024, superseding the JSON-column form ADR 0022 originally chose)
  /// so entity frequency can be queried and IDF-weighted, not duplicated per-Story. Empty for
  /// every Story created before ticket 34 shipped — no backfill.
  storyEntities        StoryEntity[]
  /// Entity-to-entity relations this Story's own coverage asserts (e.g. "Donald Tusk REPRESENTS
  /// Poland") — Story-scoped evidence, not a global/permanent fact about the entities involved.
  /// The assertion belongs to this join row's `storyId`, not to the Entities it references
  /// globally (ADR 0024).
  storyEntityRelations StoryEntityRelation[]
}

/// A named person/organization/place/country mentioned across Stories' coverage — a normalized,
/// deduplicated label, not a verified real-world identity (ADR 0022, ADR 0024). `key` is a
/// deterministic `type:slugify(canonicalName)` derived by the backend, never invented by the
/// LLM, so the same real-world entity mentioned identically in two different Stories reliably
/// produces the same key. Two distinct real-world entities that happen to normalize to the same
/// name can collide — an accepted, documented v1 limitation, unchanged by moving this out of
/// per-Story JSON into a shared table.
model Entity {
  id            String                 @id @default(cuid())
  key           String                 @unique
  type          EntityType
  canonicalName String
  /// Ticket 41 — nullable, no default, no backfill (ADR 0021's established no-backfill
  /// convention). Set only via an Admin-confirmed Wikidata search-and-confirm flow, never an
  /// automated/unconfirmed match (ADR 0022's entity-resolution-avoidance reasoning applies here
  /// too — see docs/spec-entity-resolution.md).
  wikidataId    String?
  /// Materialized count of Stories this Entity is attached to via StoryEntity — maintained by a
  /// transactional increment/decrement alongside each StoryEntity write, not a periodic
  /// correction job (no code path deletes a Story/StoryEntity today, so there is no drift to
  /// correct — see ADR 0024). Powers IDF weighting in storyRelationScoring.ts (fixes P1-9: plain
  /// Jaccard is the wrong metric for this project's asymmetric entity-set sizes between the
  /// Ingestion and human-seeded extraction paths).
  storyCount    Int                    @default(0)
  storyEntities StoryEntity[]
  relationsFrom StoryEntityRelation[]  @relation("EntityRelationFrom")
  relationsTo   StoryEntityRelation[]  @relation("EntityRelationTo")
  /// Ticket 40 — every EntityAlias confirmed INTO this entity (this entity is the survivor).
  aliases       EntityAlias[]          @relation("EntityAliasSurvivor")
  /// Ticket 40 — set only if this entity was itself merged away into another. At most one, not
  /// zero-or-many: `EntityAlias.mergedFromEntityId` is `@unique` because a merged-away entity is
  /// never re-selected as a merge target again (mergeEntities flattens any alias that already
  /// pointed at it onto the new survivor directly — see that function's own comment).
  mergedInto    EntityAlias?           @relation("EntityAliasMergedFrom")
  rejectionsA   EntityAliasRejection[] @relation("EntityAliasRejectionA")
  rejectionsB   EntityAliasRejection[] @relation("EntityAliasRejectionB")
  /// Ticket 41 — zero or one in v1 (Wikimedia is the only provider), fetched automatically by
  /// `entity.image.enrich` once `wikidataId` is linked. No `isPrimary` field yet (ADR 0034): with
  /// one provider there's nothing to prioritize among.
  images        EntityImage[]

  /// Fuzzy name search over `canonicalName` (ticket 12) is a trigram GIN index
  /// (`entity_canonicalName_trgm_idx`, requires the `pg_trgm` extension), written by hand in this
  /// migration — Prisma's schema DSL can't express an operator-class index without extra preview
  /// features this project doesn't otherwise need, same convention as Coverage's partial unique
  /// index and StoryEntityRelation's CHECK constraint. Ticket 40's candidate query
  /// (repositories/entityAlias.ts) is its first real consumer.
  @@index([type])
}

/// Join row: this Story's coverage mentions this Entity, at this confidence/salience. The
/// Story-scoped evidence itself (ADR 0022's entity-resolution-avoidance reasoning is unaffected by
/// ADR 0024's storage-shape change) — `confidence` is the extraction pass's own per-entity
/// confidence, carried over unchanged from the JSON form this replaces.
model StoryEntity {
  storyId    String
  story      Story  @relation(fields: [storyId], references: [id])
  entityId   String
  entity     Entity @relation(fields: [entityId], references: [id])
  confidence Float
  /// Fraction of this Story's source-text fragments that mention this entity, 0 to 1 (ticket 12) —
  /// a structural "how central is this entity to this Story" signal, computed once at extraction
  /// time from the model's own per-entity `source_indices` output (entityExtractionPass.ts).
  /// Stored now; not yet read by storyRelationScoring.ts's IDF-weighted containment formula —
  /// wiring it in is a deliberate follow-up (see the ticket's own Answer), not part of this
  /// migration.
  salience   Float  @default(0)

  @@id([storyId, entityId])
  /// The query a JSON column could never do: "all Stories mentioning entity X" (ADR 0024).
  @@index([entityId])
}

/// What one Story's own coverage asserts about two of its Entities (e.g. "Donald Tusk REPRESENTS
/// Poland") — the assertion belongs to `storyId`, never a global/permanent fact about the
/// Entities involved (ADR 0022). Not the same thing as StoryRelation, which links two Stories,
/// not two Entities within one Story — see CONTEXT.md's Event Graph entry. A `fromEntityId <>
/// toEntityId` CHECK constraint is written by hand in this migration, same as Coverage's partial
/// unique index — Prisma's schema DSL can't express a CHECK constraint.
model StoryEntityRelation {
  id           String             @id @default(cuid())
  storyId      String
  story        Story              @relation(fields: [storyId], references: [id])
  fromEntityId String
  fromEntity   Entity             @relation("EntityRelationFrom", fields: [fromEntityId], references: [id])
  toEntityId   String
  toEntity     Entity             @relation("EntityRelationTo", fields: [toEntityId], references: [id])
  type         EntityRelationType
  confidence   Float

  @@unique([storyId, fromEntityId, toEntityId, type])
  @@index([fromEntityId])
  @@index([toEntityId])
}

/// A name variant Admin-confirmed to refer to the same real-world entity as `entityId`'s Entity
/// row (ticket 40, ADR 0033) — the redirect this project's aliasing mechanism relies on instead of
/// hard-rewriting every foreign key and deleting the merged-away row. `alias` is the merged-away
/// entity's own `key` at merge time (never its `canonicalName` — resolveEntityKey below matches on
/// `key`, the same deterministic identifier every entity-resolution call site already uses).
/// `mergedFromEntityId` keeps that row's id for audit even though the row itself survives,
/// unaltered, purely as a redirect target. Never auto-applied — every row here traces back to an
/// Admin's explicit confirm action (`entity.alias_merged` in AdminActionLog), same posture as
/// StoryRelation's LOW-confidence review queue (ADR 0012).
model EntityAlias {
  id                 String   @id @default(cuid())
  entityId           String
  entity             Entity   @relation("EntityAliasSurvivor", fields: [entityId], references: [id])
  alias              String   @unique
  /// `@unique`: a merged-away entity is never re-selected as a merge target again — the candidate
  /// query excludes any entity already appearing here from both sides of a future pair. If that
  /// entity's own survivor is later merged away too, mergeEntities flattens this row's `entityId`
  /// onto the new final survivor directly, so resolveEntityKey stays a single lookup and never has
  /// to walk a chain.
  mergedFromEntityId String   @unique
  mergedFromEntity   Entity   @relation("EntityAliasMergedFrom", fields: [mergedFromEntityId], references: [id])
  /// Actor id of the confirming Admin — mirrors AdminActionLog's actorId. This is the durable
  /// resolution record itself, not a duplicate of that log (AdminActionLog is the audit trail of
  /// the action that produced it, inspected via Prisma Studio like every other admin log here).
  confirmedBy        String
  createdAt          DateTime @default(now())

  @@index([entityId])
}

/// A candidate same-entity pair an Admin has looked at and decided is NOT the same real-world
/// entity — permanent, mirrors StoryRelation.status's REJECTED semantics (ticket 36): excluded
/// from every future candidate query rather than re-surfaced. `entityIdA`/`entityIdB` are stored
/// in a fixed order (`entityIdA < entityIdB` by plain string comparison, enforced by the code that
/// writes this row, not a DB constraint — same convention as this schema's other app-level
/// dedup checks) so a pair is excluded regardless of which order a later candidate query produces
/// it in.
model EntityAliasRejection {
  id         String   @id @default(cuid())
  entityIdA  String
  entityA    Entity   @relation("EntityAliasRejectionA", fields: [entityIdA], references: [id])
  entityIdB  String
  entityB    Entity   @relation("EntityAliasRejectionB", fields: [entityIdB], references: [id])
  rejectedBy String
  createdAt  DateTime @default(now())

  @@unique([entityIdA, entityIdB])
}

/// An Entity's image, fetched automatically from an external provider once an Admin links
/// `Entity.wikidataId` (ticket 41 / ADR 0034) — enrichment of an identity the Admin already
/// vouched for, not a second Admin-confirmed action of its own. No `isPrimary`: v1 has exactly one
/// provider, so an Entity has zero or one image, nothing to prioritize among yet.
model EntityImage {
  id           String              @id @default(cuid())
  entityId     String
  entity       Entity              @relation(fields: [entityId], references: [id], onDelete: Cascade)
  provider     EntityImageProvider
  externalId   String
  imageUrl     String
  thumbnailUrl String?
  author       String?
  license      String?
  sourceUrl    String
  width        Int?
  height       Int?
  createdAt    DateTime            @default(now())

  @@unique([provider, externalId])
  @@index([entityId])
}

/// A typed, directional Story-to-Story edge in the Event Graph (ticket 35) — the newer Story
/// (`fromStoryId`) matched backward against an already-visible, older candidate (`toStoryId`)
/// during its own one-time relation-candidate generation pass; read bidirectionally for display
/// (a Story's "related Events" includes rows where it's either side). See ADR 0022.
model StoryRelation {
  id             String                      @id @default(cuid())
  fromStoryId    String
  fromStory      Story                       @relation("StoryRelationFrom", fields: [fromStoryId], references: [id])
  toStoryId      String
  toStory        Story                       @relation("StoryRelationTo", fields: [toStoryId], references: [id])
  type           StoryRelationType
  /// Categorical, not a raw score (ADR 0022) — HIGH publishes immediately, LOW waits in the
  /// Admin review queue (ticket 36).
  confidenceTier StoryRelationConfidenceTier
  /// Plain-language reason from the confirming LLM call — traceability for why these two Stories
  /// are linked, shown wherever the relation is surfaced (tickets 36/37).
  reasoning      String
  status         StoryRelationStatus
  createdAt      DateTime                    @default(now())

  @@unique([fromStoryId, toStoryId])
  /// findPublishedRelationsForStory reads both sides of the edge ("a Story's related Events
  /// includes rows where it's either fromStoryId or toStoryId") — the unique constraint above
  /// covers lookups keyed on fromStoryId, but toStoryId needs its own index for the other side.
  @@index([toStoryId])
  /// The Admin review queue's findPendingReviewRelations query: filter by status, order by
  /// createdAt.
  @@index([status, createdAt])
}

/// A materialized connected component over PUBLISHED FOLLOW_UP StoryRelation edges (ticket 17,
/// ADR 0029) — `StoryRelation` stays the source of truth, `Thread`/`ThreadMember` are a derived
/// read model rebuilt by the `thread.recompute` job (§8.6, docs/audit.md) whenever a relevant edge
/// is confirmed. Exists to show a reader the full multi-stage arc a pairwise "related Events"
/// list can't ("a detention, then an official's statement, then the other side's response," each
/// otherwise looking like its own unrelated Story).
model Thread {
  id           String         @id @default(cuid())
  /// Generated once, at Thread creation, from Agreement across every member — never regenerated
  /// as new members join (see threadTitlePass.ts / ticket 17's Answer).
  title        String
  /// Not yet linked from any route in this ticket (see ticket 17's Answer, Q3/Q5) — declared to
  /// match ADR 0029's already-accepted schema, ready for a future dedicated Thread page.
  slug         String         @unique
  firstEventAt DateTime
  lastEventAt  DateTime
  status       ThreadStatus   @default(ACTIVE)
  memberCount  Int            @default(0)
  members      ThreadMember[]

  /// "All ACTIVE Threads, most recently active first" — no reader surface queries this yet
  /// (ticket 17's Answer, Q5); declared because ADR 0029's accepted schema already specifies it.
  @@index([status, lastEventAt])
}

model ThreadMember {
  threadId String
  thread   Thread     @relation(fields: [threadId], references: [id])
  /// A Story belongs to at most one Thread.
  storyId  String     @unique
  story    Story      @relation(fields: [storyId], references: [id])
  /// Ordered by eventTime (falling back to createdAt, ticket 16), never createdAt directly —
  /// re-derived wholesale on every recompute (replaceThreadMembers), not incrementally patched.
  position Int
  role     ThreadRole
  addedAt  DateTime   @default(now())

  @@id([threadId, storyId])
  @@index([threadId, position])
}

model Analysis {
  id               String            @id @default(cuid())
  storyId          String            @unique
  story            Story             @relation(fields: [storyId], references: [id])
  seedUrl          String
  seedHeadline     String
  status           AnalysisStatus    @default(PENDING)
  createdAt        DateTime          @default(now())
  coverages        Coverage[]
  synthesisResult  SynthesisResult?
  pendingAdditions PendingAddition[]

  /// The reader listing (status COMPLETE) and the Draft review queue (status DRAFT) both filter
  /// by status and sort by createdAt desc.
  @@index([status, createdAt])
}

model Coverage {
  id               String         @id @default(cuid())
  analysisId       String
  analysis         Analysis       @relation(fields: [analysisId], references: [id])
  sourceId         String
  /// Resolved once via resolveSource() at Coverage-creation time (fixes P0-6, docs/audit.md) —
  /// the same real outlet always produces the same Source regardless of which path (RSS,
  /// GDELT, human-seeded/custom URL) found it. Read Source.name for display, never a free-text
  /// outlet column (removed — that inconsistency was the bug).
  source           Source         @relation(fields: [sourceId], references: [id])
  title            String?
  articleUrl       String
  publishedAt      String?
  extractedText    String?
  extractionResult Json?
  status           CoverageStatus @default(PENDING)
  excluded         Boolean        @default(false)
  /// Ingest time, not publishedAt (which is the outlet's own claimed publish time, a String, and
  /// sometimes absent). Bounds findAllArticleUrls' dedup-check window (P0-2, docs/audit.md,
  /// ticket 03) — a Coverage from months ago realistically never needs re-checking against a
  /// fresh 20-minute RSS poll.
  createdAt        DateTime       @default(now())

  /// Every Coverage read is scoped to one Analysis and almost always filters excluded/status too
  /// (findCoveragesForAnalysis, findAnalysesWithCoverageCount's per-row count).
  @@index([analysisId, excluded, status])
  /// "Each Source contributes at most one Coverage per Analysis" (CONTEXT.md) — enforced at the
  /// DB level as a partial unique index (excluded Coverage doesn't count, matching the existing
  /// app-level dedup checks) written by hand in this migration; Prisma's schema DSL can't express
  /// a WHERE-filtered unique index, so it isn't declared here — see migration.sql.
  @@index([sourceId])
  /// findAllArticleUrls' recency-bounded scan (P0-2, ticket 03).
  @@index([createdAt])
}

model SynthesisResult {
  id                          String                     @id @default(cuid())
  analysisId                  String                     @unique
  analysis                    Analysis                   @relation(fields: [analysisId], references: [id])
  dimensions                  Json
  /// Source Overlap (ticket 38, ADR 0030): counted, never model-generated -- for each item in
  /// `dimensions.agreement`, the number of distinct outlets among its attributions, meaned and
  /// divided by the Analysis's source count, as a whole-number percentage. Null means "undefined
  /// for this Analysis" (an empty `agreement` dimension has nothing to measure), never "not
  /// computed yet" -- see computeSourceOverlapPercentage (services/sourceOverlap.ts). The four
  /// rows that existed when this column was added were backfilled to null (not retroactively
  /// computed) rather than left to block the migration -- see its own comment.
  sourceOverlapPercentage     Int?
  /// Source Overlap (ticket 38, ADR 0030): the model's own story-level read, returned alongside
  /// the four dimensions in the same structured-output call (SynthesisResultSchema). The four
  /// rows that existed when this column was added never had this judged by the model; they were
  /// backfilled to PARTIAL as a neutral placeholder -- see the migration's own comment.
  agreementCategory           SynthesisAgreementCategory
  narrative                   Json?
  /// Tool-authored, short Czech headline for the Article — generated once, eagerly, from only
  /// the Agreement dimension, in the same transaction that marks the Analysis COMPLETE (see
  /// ADR 0021). Distinct from Analysis.seedHeadline (the pre-completion working title, always
  /// one source's original) and Story.anchorHeadline (the internal matching anchor) — neither of
  /// those is touched by this field. Null if generation was skipped because Agreement was empty
  /// at completion time, or for any Analysis completed before this feature existed.
  headline                    String?
  /// Set when the most recent narrative-generation attempt failed (LLM error, or quote
  /// verification dropping every segment). Originally a live TTL-retry gate for
  /// `getAnalysisDetail` (ADR 0026, fixes P0-5, docs/audit.md); since ticket 15 (ADR 0028),
  /// generation happens once via the `narrative.generate` job, enqueued atomically when the
  /// Analysis reaches COMPLETE, and this field is a pure audit trail — nothing reads it back to
  /// gate a retry any more. `pg-boss`'s own `LLM_JOB_RETRY_POLICY` (ticket 13) is the only retry
  /// mechanism now. Cleared (implicitly, by `narrative` becoming non-null) on a successful
  /// generation.
  narrativeGenerationFailedAt DateTime?
  /// The illustrative lead image selected for this Narrative (ticket 51), if one was found — see
  /// `NarrativeImage` below. Fetched by the same `narrative.generate` job, after the
  /// `NarrativeDocument` itself, and never re-fetched afterward (new Analyses only; no backfill
  /// for Analyses completed before this feature shipped, per ADR 0021's established no-backfill
  /// convention for this project).
  narrativeImage              NarrativeImage?
}

/// A single illustrative lead image selected for a Narrative by topic relevance (ticket 51) —
/// never scraped from any source outlet's own article image (licensing; see the ticket's Notes).
/// Persisted once so it isn't re-fetched live on every page view, and always rendered captioned
/// "Ilustrační foto" plus this attribution (NarrativeArticle.tsx) so it can never be mistaken for
/// documentary evidence of the event. One per SynthesisResult (`synthesisResultId` is unique) —
/// this ticket scopes to a single lead image; multiple inline images per article is a
/// noted-but-deferred follow-on, which is why this is its own table rather than columns bolted
/// onto SynthesisResult. Shape mirrors `EntityImage` (ticket 41 / ADR 0034) — same provider, same
/// attribution fields — reusing `EntityImageProvider` rather than a second single-value enum for
/// the same "which image bank" concept; unlike `EntityImage`, there's no `[provider, externalId]`
/// uniqueness constraint here, since the same Commons file can legitimately be the most
/// topic-relevant image for more than one Narrative.
model NarrativeImage {
  id                String              @id @default(cuid())
  synthesisResultId String              @unique
  synthesisResult   SynthesisResult     @relation(fields: [synthesisResultId], references: [id], onDelete: Cascade)
  provider          EntityImageProvider
  externalId        String
  imageUrl          String
  thumbnailUrl      String?
  author            String?
  license           String?
  sourceUrl         String
  width             Int?
  height            Int?
  createdAt         DateTime            @default(now())
}

/// A candidate Coverage that Ingestion found for an already-COMPLETE Analysis — surfaced for Admin
/// review rather than silently reopening a completed Analysis (see ADR 0013).
model PendingAddition {
  id          String                @id @default(cuid())
  analysisId  String
  analysis    Analysis              @relation(fields: [analysisId], references: [id])
  sourceId    String
  source      Source                @relation(fields: [sourceId], references: [id])
  title       String?
  articleUrl  String
  publishedAt String?
  status      PendingAdditionStatus @default(PENDING_REVIEW)
  createdAt   DateTime              @default(now())

  /// listPendingAdditions filters by status and sorts by createdAt desc (ticket 45).
  @@index([status, createdAt])
}

/// A distinct news outlet (CONTEXT.md) — the single identity every Coverage/PendingAddition
/// resolves to via resolveSource(), replacing the free-text `outlet` string that used to be
/// generated three inconsistent ways depending on discovery path (P0-6, docs/audit.md).
model Source {
  id               String            @id @default(cuid())
  /// Display name shown to readers/Admins, e.g. "iDnes" — chosen once, here, and read through
  /// the relation everywhere a Coverage/PendingAddition used to carry its own free-text outlet.
  name             String            @unique
  /// Every hostname known to belong to this Source (apex + any subdomain actually seen in the
  /// wild, e.g. both "idnes.cz" and "servis.idnes.cz") — resolveSource() matches the most
  /// specific suffix first. A Source created automatically for a not-yet-configured domain
  /// (GDELT surfacing an outlet outside the curated RSS list) starts with just that one domain.
  domains          String[]
  createdAt        DateTime          @default(now())
  feeds            SourceFeed[]
  coverages        Coverage[]
  pendingAdditions PendingAddition[]
}

/// One RSS feed to poll for a Source — replaces the hardcoded RSS_FEEDS config array, so adding
/// or changing a feed is a data change, not a deploy. Deliberately minimal: conditional-GET
/// bookkeeping (etag, lastPolledAt, consecutiveErrors, ...) belongs to the async worker rework
/// (.scratch/backend-audit/issues/06-async-job-queue.md) and isn't added until something actually
/// reads/writes it — this table exists now only so that ticket has somewhere to read feed URLs
/// from instead of static config.
model SourceFeed {
  id         String   @id @default(cuid())
  sourceId   String
  source     Source   @relation(fields: [sourceId], references: [id])
  url        String   @unique
  /// Which feed-parsing function rss.ts dispatches to — a plain String (closed set enforced by a
  /// TS union, matching AdminActionLog/LlmCallLog's convention), not a Prisma enum, so a new kind
  /// is a data change, not a migration. "rss2" is the only value today: every outlet's feed
  /// verified as genuine RSS 2.0 (see ADR 0032/ticket 10), including several that declare an
  /// xmlns:atom namespace only for a self-link tag — that's not evidence of an Atom feed.
  parserKind String   @default("rss2")
  createdAt  DateTime @default(now())

  @@index([sourceId])
}

/// Every LLM chat-completion call the backend makes (extraction/synthesis/narrative/story
/// verification/keyword extraction — see ADR 0020), recorded for debugging: what was sent, what
/// came back or the error thrown, and which pass made the call. Deliberately unrelated to
/// Analysis/Coverage/Story — several call sites (e.g. keyword extraction on a brand-new
/// submission) run before those exist yet. No pruning/retention is implemented (ADR 0020) — this
/// table grows without bound by design, for now.
model LlmCallLog {
  id              String   @id @default(cuid())
  /// Which module made the call: 'extraction' | 'synthesis' | 'narrative' | 'storyVerification'
  /// | 'keywordExtractor' today; ticket 31 adds an 'embedding'-shaped caller onto this same table.
  callSite        String
  model           String
  /// Nullable, not because a chat-completion call ever omits them (callJsonModel always sets
  /// both), but so ticket 31's differently-shaped embedding calls (no system/user prompt split)
  /// can share this table without a second migration to loosen these columns after the fact.
  systemPrompt    String?
  userContent     String?
  /// The raw response content on success, or the malformed content that failed to parse — null
  /// only when the call itself never returned (the API call/network failed before any content
  /// was received). Exception: an 'embedding' callSite never logs the raw vector here (P0-4,
  /// docs/audit.md) — just `{ dimensions }`, since a float array has ~no debugging value per byte
  /// compared to the text this column otherwise holds.
  responseContent String?
  /// Null on success. Set for any failure: the OpenAI API call throwing, or its response failing
  /// to parse as JSON.
  error           String?
  createdAt       DateTime @default(now())
}

enum MatchDecidedBy {
  THRESHOLD
  LLM
}

/// One row per same-event matching decision (findBestMatch, storyMatching.ts) — Ingestion's
/// per-item attach check and human-seeded submission's dedup check both write here (ADR 0025's
/// sibling ticket, docs/audit.md §7.5/§8.7). Exists purely for future threshold calibration —
/// MATCH_THRESHOLD's own comment admits it's "a starting point, not a tuned result" — never read
/// by any product surface, inspected via Prisma Studio like LlmCallLog. Deliberately no FK to
/// Story/Analysis (same reasoning as LlmCallLog, ADR 0020): purely observational. Deliberately
/// scoped to same-event matching only, not StoryRelation candidate scoring — a structurally
/// different decision (links two already-distinct Stories, different feature set and cost
/// profile) whose calibration would only be muddied by sharing one table/threshold-sweep with
/// this one.
model MatchDecision {
  id                  String         @id @default(cuid())
  createdAt           DateTime       @default(now())
  /// 'ingestion' | 'submissionDedup' — same values as EmbeddingCallSite (embeddingClient.ts).
  callSite            String
  /// The single best-scoring candidate the threshold stage considered, if the pool was
  /// non-empty and at least one candidate fell within the hard time window. Null alongside a
  /// null `score` means "nothing to compare against," distinct from "a candidate existed but
  /// scored below threshold."
  candidateStoryId    String?
  candidateAnalysisId String?
  /// The raw cosineSimilarity score that drove `thresholdMatched` — findBestMatch's score is
  /// pure similarity as of ADR 0025/P1-9's fix (no time-decay). Null exactly when
  /// candidateStoryId is null.
  score               Float?
  /// What MATCH_THRESHOLD alone decided, independent of whatever the LLM later says.
  thresholdMatched    Boolean
  /// sameEvent from verifySameStoryLogged, when the human-seeded path's confirmation actually
  /// ran (only possible when thresholdMatched=true on that path) — null on every Ingestion row
  /// (ADR 0018: Ingestion's own attach decision never gets an LLM call) and on any human-seeded
  /// row where thresholdMatched was already false.
  llmVerdict          Boolean?
  /// 'THRESHOLD' when nothing overrode the threshold stage's own verdict (no LLM ran, or none
  /// was eligible to); 'LLM' when the human-seeded confirmation call's verdict is what actually
  /// decided the outcome.
  decidedBy           MatchDecidedBy
  /// Bump whenever storyMatching.ts's scoring math changes, so a future calibration query can
  /// segment rows by which formula actually produced them.
  scorerVersion       String

  @@index([callSite, createdAt])
}

/// Content-addressed cache: the same (model, inputHash) always produces the same vector
/// (deterministic given a fixed model), so a cache hit here skips the embeddings API call
/// entirely — checked inside generateEmbedding() itself (embeddingClient.ts), transparent to
/// every caller (ADR 0025). A hit never writes to LlmCallLog: no LLM call happened, and
/// LlmCallLog is specifically a record of one (ADR 0020). Storing the raw vector here is not in
/// tension with ADR 0023 (which kept the vector out of LlmCallLog specifically as a *debug log*
/// with ~no per-byte debugging value) — here the vector is the cache's entire payload, not a
/// byproduct of a call worth debugging. Unbounded, no pruning, same accepted posture as
/// LlmCallLog.
model EmbeddingCache {
  model     String
  inputHash String
  embedding Float[]
  createdAt DateTime @default(now())

  @@id([model, inputHash])
}

/// A single-row lease preventing two runIngestionPass calls from overlapping (P2-22,
/// docs/audit.md) — not a generic job-queue primitive (that's the deferred Etapa 5 work, see
/// .scratch/backend-audit/issues/06-async-job-queue.md), just a lightweight claim/release
/// scoped to this one job. The scheduler itself (docker-compose.yml's curl-then-sleep loop)
/// structurally can't overlap its own scheduled triggers; this guards the real exposure — a
/// manual/admin-triggered run racing an in-flight scheduled one. Deliberately a row-level lease
/// with a stale timeout, not a raw Postgres advisory lock held for the run's duration:
/// runIngestionPass makes many separate calls (RSS fetches, embedding API calls) that are not,
/// and should not become, one long-lived DB transaction — a session-scoped advisory lock can't
/// be reliably held across Prisma's pooled connections for a function shaped like that. The
/// claim/release itself is each a single short, atomic conditional UPDATE (see
/// repositories/ingestionRunLock.ts), matching this codebase's existing
/// updateAnalysisStatusIfCurrently/updateStoryRelationStatusIfCurrently idiom.
model IngestionRunLock {
  id           String    @id
  runningSince DateTime?
  /// Set alongside runningSince when claimed; release only clears the row if this still matches
  /// the releasing caller's own id — guards against a stale lease being reclaimed by a new run
  /// and then incorrectly cleared by the old run's own (late-finishing) `finally` block.
  runId        String?
}

/// Who did what to what, when — an admin action that spends LLM money or changes state
/// irreversibly (P2-24, docs/audit.md; ticket 09). Maintainer-only, same convention as
/// `LlmCallLog`/`MatchDecision`: inspected via Prisma Studio, never surfaced in the app itself,
/// no FK relation into the live domain tables it references (an FK to `User` would force a
/// choice between blocking user deletion or losing audit history when a user is removed — a
/// log's whole point is outliving its subject). `action`/`targetType` are plain `String`,
/// enforced by closed TS union types at every call site (`repositories/adminActionLog.ts`), same
/// idiom as `LlmCallLog.callSite`/`LlmCallSite` — not a DB enum, so a new action never needs a
/// migration to add.
model AdminActionLog {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  actorId    String
  action     String
  targetType String
  targetId   String

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
}
