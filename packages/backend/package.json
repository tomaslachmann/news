{
  "name": "@news-triangulator/backend",
  "version": "0.0.1",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "SERVICE_NAME=backend tsx watch --env-file-if-exists=../../.env src/index.ts",
    "worker": "SERVICE_NAME=worker tsx watch --env-file-if-exists=../../.env src/worker.ts",
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@mozilla/readability": "^0.6.0",
    "@news-triangulator/shared": "*",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.3.2",
    "jsdom": "^29.1.1",
    "jsonwebtoken": "^9.0.3",
    "openai": "^7.4.0",
    "pg-boss": "^12.27.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prisma": "^5.22.0",
    "rotating-file-stream": "^3.2.10",
    "rss-parser": "^3.13.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.1.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsdom": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.15.31",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  }
}
