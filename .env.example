# Database
# Prisma connection string for PostgreSQL
DATABASE_URL=postgresql://news:news@localhost:5432/news

# OpenAI
# Your OpenAI API key
OPENAI_API_KEY=sk-...

# Model selection (defaults shown)
# Model used for per-article extraction pass
EXTRACTION_MODEL=gpt-4o

# Model used for the Story-scoped entity/entity-relation extraction pass (ticket 11)
ENTITY_MODEL=gpt-4o

# Model used for cross-source synthesis pass
SYNTHESIS_MODEL=gpt-4o

# Model used to embed incoming RSS items for Ingestion's cheap candidate matching (ADR 0018)
EMBEDDING_MODEL=text-embedding-3-small

# Authentication (required by ticket 10)
# Secret used to sign JWT tokens — use a long random string
JWT_SECRET=change-me-to-a-long-random-secret

# Admin account created on first run
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Automated Ingestion
# Shared secret the docker-compose ingestion-cron sidecar sends to POST /api/ingestion/run.
# Leave unset to disable the endpoint entirely (it always rejects without a matching secret).
INGESTION_SECRET=change-me-to-a-long-random-secret

# Web Push (ticket 82 — "Sledovat vlákno" Thread-update notifications)
# Generate a real keypair once with `npx web-push generate-vapid-keys` and provision it as a
# deploy secret — VAPID_PUBLIC_KEY is served to the frontend (GET /api/push/public-key, not
# secret itself); VAPID_PRIVATE_KEY signs the push request and must stay server-side only.
VAPID_PUBLIC_KEY=change-me-run-npx-web-push-generate-vapid-keys
VAPID_PRIVATE_KEY=change-me-run-npx-web-push-generate-vapid-keys
# Contact address web-push puts in the VAPID JWT's `sub` claim, per the Web Push protocol —
# lets a push service operator reach you if this server's pushes need to be rate-limited/blocked.
VAPID_CONTACT_EMAIL=mailto:admin@example.com

# Docker Compose Postgres credentials (optional, defaults shown)
POSTGRES_USER=news
POSTGRES_PASSWORD=news
POSTGRES_DB=news
